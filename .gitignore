# .gitignore - קבצים ותיקיות שאסור/לא צריך שייכנסו לריפו של git

# סביבת הפייתון המקומית (venv) - נבנית מחדש בכל מחשב לפי requirements.txt, אין טעם לשמור אותה ב-git
venv/

# קבצי מטמון של פייתון
__pycache__/
*.pyc

# בסיס הנתונים המקומי - נוצר אוטומטית בכל הרצה (database.py), לא צריך לשמור אותו ב-git
clinic.db

# משתני סביבה מקומיים - כולל מפתחות API אמיתיים (כמו GEMINI_API_KEY). אסור שזה ייכנס ל-git!
# ראו .env.example לתבנית הקובץ בלי ערכים אמיתיים.
.env

# קבצי מערכת של macOS
.DS_Store
